#
#  k2d_generic.mac
#
################################################################################
#
#  This macro plots a structure and its intensity pattern
#
################################################################################
#
rese
#
load ni,$1.inte
load cr,$1.plot
#
nfra 2
sfra 1, 0.00, 0.30, 0.54, 1.00
sfra 2, 0.48, 0.30, 1.00, 1.00
#
kfra 1,1
kfra 2,2
#
afra 1
  buff 0.06,0.06,0.10,0.00       # reserve buffer space around the frames
  aver 1.0                       # set ratio y/x to 1.0
  angle 90.0                     # set angle x/y-axis = 90.0 degrees
  achx [ H 0 0 ]                 # text along x-axis
  achy [ 0 K 0 ]                 # text along y-axis
  hart 1,2                       # select bitmap style plotting
  cmap fire                      # select fire as color map scheme
# hlin 1,1e5,1e5,20              # draw 20 z-levels from 1e5 in 1e5 intervals
  hlin 1,0.2,0.2, 40, %          #
  tit1                           # switch title line 1 off
  tit2                           # switch title line 1 off
  fnam off                       # do not show file name
  achz OFF                       # do not display levels for z-axis
#
r[0] = max(xmin[2],-25.0)
r[1] = min(xmax[2], 25.0)
r[2] = max(ymin[2],-25.0)
r[3] = min(ymax[2], 25.0)
afra 2
  aver 1.0000
  skal r[0],r[1],r[2],r[3]
  mark 
  fnam off
  tit1 
  tit2 
  achx [x 0 0]
  achy [0 y 0]
  msize 1,0.3
  fset -3                        # place y-xis marker and text on right side
#
plot
wait return
#
afra 1
  buff 0.06,0.06,0.10,0.00       # reserve buffer space around the frames
  skal -1.0, 1.0, -1.0, 1.0
#
plot
