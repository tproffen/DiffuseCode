@../prep_var.mac
set parallel, useomp:serial
discus   ! Switch to discus section
#
#@ HEADER
#@ NAME         powder.mac
#@ 
#@ KEYWORD      powder, small crystal
#@ 
#@ DESCRIPTION  reads a unit cell, expands it to a user defined size 
#@ DESCRIPTION  and calculates the powder pattern
#@
#@ PARAMETER    $0, 1
#@ PARAMETER    $1, integer,  number of unit cells
#@
#@ USAGE        @powder <number> 
#@
#@ END
#
################################################################################
#
read                            # Switch to read menu
  cell primitive.cell,$1,$1,$1  # read the unit cell expand to $1*$1*$1 cells 
#
powder                          # Switch to powder menu
  reset
  xray                          # Select X-rays
  set axis,q                    # Perform calculation on equaly spaced Q grid
  set calc,debye                # Use Debye-algorithm
  set disp,off                  # Switch anomalous dispersion off
  set delta,0.0                 # Set simple convolution by Gaussian off
  set qmin,0.500                # Starting value for Q
  set qmax,7.100                # Final value for Q
  set dq,  0.005                # Step size for Q
# set tthmin,8.0
# set tthmax, 120.
# set dtth, 0.01
  set profile, off             # Switch convolution by Pseudovoigt function off
#  set profile, pseudo           # Use Pseudovoigt (instead of Gaussian)
#  set profile, uvw, 0.000, 0.000, 0.001 # Cagliotti u,v,w values 
#  set profile, eta, 0.500       # Mixing parameter 1=Lorenzian 0=Gaussian
#  set profile, asym, 0.00, 0.00, 0.00, 0.00 #Asymmetry parameters
  set temp,use                  # Use the Atomic displacement parameters
  set wvle,1.54056              # Set the wavelength
  set wvle,0.20000              # Set the wavelength
  set four,four                 # Just for stacking fault mode, set to normal
  set lpcor,bragg,26.58         # Define Lorentz-Pol to BraggBrentano Diffractometer
show
  run                           # Do the actual calculation
exit                            # Go back to main DISCUS menu
#
output                          # Switch to output menu
# outf  powder.q                # Define output file name
# value inte                    # Select intensity as output value
# form  powder,q                 # Write output as powder data
# run                           # Perform the actual output
  outf  powder.inte             # Define output file name
  value inte                    # Select intensity as output value
  form  powder,tth,1.0,180,0.01   # Write output as powder data
  run                           # Perform the actual output
exit                            # Go back to main DISCUS menu
#
branch kuplot
   @kpowder.mac inte
   exit
#
#
# Test for Success
#
branch kuplot
#
load xy, RESULTS/powder.inte
rval 1, 2, one
r[0] = res[1]
if(abs(r[0]) < 0.001) then
  LTEST_MAC = TRUE
else
  LTEST_MAC = FALSE
endif
exit
exit
