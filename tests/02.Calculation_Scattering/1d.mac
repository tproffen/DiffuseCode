#@ HEADER
#@ NAME         1d.mac
#@ 
#@ KEYWORD      fourier, 1d, row, finite size
#@ 
#@ DESCRIPTION  This macro modifies a simple structure
#@ DESCRIPTION  The macro creates a 1 dimensional line
#@ DESCRIPTION  of silicon atoms and calculates
#@ DESCRIPTION  the scattering in reciprocal space in 
#@ DESCRIPTION  a line parallel to the atoms
#@
#@ PARAMETER    $0, 1
#@ PARAMETER    $1, integer, number of atoms
#@
#@ USAGE        @1d <number> 
#@
#@ END
################################################################################
discus
#
read                          # switch to the DISCUS read menu
  cell silicon.cell ,$1,1,1   # use the file silicon.cell
#
show atom,all                 # show all atoms 
eval n[1]                     # evaluate the variable n[1], i.e. number of atoms
i[99] = n[1]
#
@plot.mac 1d                  # run the macro plot.mac with input parameter 1d
#
fourier                       # switch to the DISCUS fourier menu
  reset
  neutron                     # select neutron diffraction
                              # define three corners in reciprocal space
  ll -2.5, 0.00, 0.00         #   lower left  
  lr  2.5, 0.00, 0.00         #   lower right
  ul -2.5, 0.00, 0.00         #   upper left
  na  1001                    # define number of points along abscissa
  no     1                    # define number of points along ordinate
  abs   h                     # use the value of h as x-axis in KUPLOT
  ord   k                     # use the value of k as y-axis in KUPLOT
  temp  ign                   # ignore the atomic displacement parameter
  disp  off                   # switch anomalous dispersion off
  set aver,0.0                # switch subtraction of average off
  lots  OFF                   # turn lots off
  show                        # print the status onto the screen
  run                         # perform the actual calculation
exit                          # go back to the main DISCUS menu
#
output                        # switch to the DISCUS output menu
  outf 1d.inte                # the output file will be called 1d.inte
  value inte                  # write intensities into the file
  form  stan                  # select standard output format
  run                         # perform the actual write process
exit                          # go back to the main DISCUS menut
#
branch kuplot
   @k1d.mac 1d
   exit
#
# Test for Success
#
branch kuplot
#
load xy, RESULTS/1d.inte
rval 1, 3, one
r[0] = res[1]
if(abs(r[0]) < 0.001) then
  LTEST_MAC = TRUE
else
  LTEST_MAC = FALSE
endif
exit ! Back to DISCUS

exit
