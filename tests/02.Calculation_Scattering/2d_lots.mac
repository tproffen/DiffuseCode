#
#@ HEADER
#@ NAME         2d_lots.mac
#@ 
#@ KEYWORD      fourier, 2d, finite size, lots
#@ 
#@ DESCRIPTION  This macro reads a prepared structure and calculates 
#@ DESCRIPTION  a 2-D section in reciprocal space. The effect of 
#@ DESCRIPTION  'fourier lots' is demonstrated.
#@
#@ PARAMETER    $0, 1
#@ PARAMETER    $1, character <file_name>
#@
#@ USAGE        @2d_lots example3
#@
#@ END
#
################################################################################
discus
#
read
  stru example3.stru     #  keyword stru means we read the structure as is
#
@plot.mac example3       #  run macro plot.mac with parameter <example3>
#
fourier                  # switch to the DISCUS fourier menu
  xray                   # select x-rays
  ll 0,0,0               # set the lower left corner 
  lr 4,0,0               # set the lower right corner  
  ul 0,4,0               # set the upper left corner  
  na 301                 # calculate with 301 points along abscissa
  no 301                 # calculate with 301 points along ordinate
  temp use               # use atomic displacement parameters
  disp off               # switch anomalous dispersion off
  wvle 1.00              # set the wave length to 1.0 Angstroem
  abs h                  # use h for x-axis in KUPLOT
  ord k                  # use k for y-axis in KUPLOT 
  set aver, 100          # subtract average intensity
  lots box,14,14,1,100,yes # use 50 box shaped lots size 14*14*1
  show                   # show current settings
  run                    # do the calculation
exit                     # go back to the main DISCUS menu
#
output                   # switch to the DISCUS output menu
  outf example3.inte     # write data into file <example3.inte>
  value inte             # write intensities
  form stan              # use standard format
  run                    # perform the actual write process
exit                     # go back to the main DISCUS menu
#
branch kuplot
  @k2d.mac example3
  exit
#
#
# Test for Success
#
branch kuplot
#
load ni, RESULTS/example3_lots.inte
rval 1, 3, one
r[0] = res[1]
if(abs(r[0]) < 0.130) then          ! Considerable noise
  LTEST_MAC = TRUE
else
  LTEST_MAC = TRUE
endif
exit
#
# Test for Success
#
branch kuplot
#
load ni, RESULTS/example3_lots.inte
rval 1, 3, one
r[0] = res[1]
if(abs(r[0]) < 0.151) then
  LTEST_MAC = TRUE
else
  LTEST_MAC = FALSE
endif
exit
exit   ! Back to SUITE
