#
#  plot.cif.mac
#  Write cif file and plot the structure using jmol
#
plot
  reset
#  program   jmol   ! JMOL is interactive only; disabled for the test suite
  program   cif      ! writes the same CIF file without JMOL
  outfile   "PLOT/$1_%5.1F_%5.1F.cif",diameter_ab,diameter_c
  select    all             ! Select al atom types
  extend    all             ! Plot entire crystal
#  run       plot:inter, kill:yes      ! Do interactive plot, kill previous windows
  run
exit
