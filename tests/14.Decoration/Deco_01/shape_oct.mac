variable integer, ncell
variable real   , distance
ncell =  8
read
   cell CELL/$1.cell, ncell+1,ncell+1,ncell+1
distance = ncell/2*lat[1]*sqrt(1./3.)+ 0.1
#
surface
   set distance, external, all, 1.90
   boundary form,  1, 1, 1, distance                 
exit
purge
#
@plot.mac $1_octahedron
chem
   elem
exit
