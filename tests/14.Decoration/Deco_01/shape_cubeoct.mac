variable integer, ncell
variable real   , distance_111
ncell =  10
read
   cell CELL/gold.cell, ncell+1,ncell+1,ncell+1
distance_111 = ncell/2*lat[1]*sqrt(1./3.)+ 0.1
#
surface
   set distance, external, all, 1.90
   boundary form, cubeoct , distance_111
exit
purge
@plot.mac gold_cubeoctahedron
chem
   elem
exit
