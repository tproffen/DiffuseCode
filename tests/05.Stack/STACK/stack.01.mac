#@ HEADER
#@ NAME         stack.01.mac
#@ 
#@ KEYWORD      stacking fault, hexagonal, hcp, fcc
#@ 
#@ DESCRIPTION  This macro creates a simple structure with stacing faults
#@ DESCRIPTION  The basic types are hexagonal closed packed and cubic closed 
#@ DESCRIPTION  packed. No fourier is calcualted
#@
#@ PARAMETER    $0, 1
#@ PARAMETER    $1, real,  probability
#@
#@ USAGE        @stack.01 <probability>
#@
#@ END
################################################################################
#
discus
#
read
  cell  hexagonal.cell,10,10, 1
#
save
  outfile hexagonal.layer
  run
exit
#
stack
  layer  hexagonal.layer
  layer  hexagonal.layer
  trans  1,1, 1./3.,-1./3., 1./2
  trans  1,2,-1./3., 1./3., 1./2
  trans  2,1, 1./3.,-1./3., 1./2
  trans  2,2,-1./3., 1./3., 1./2
#
  aver   0.00, 0.00, 1.00
  modul  1.00, 0.00, 0.00, 0.00, 1.00, 0.00
  set    modulus,on
  set    trans,fixed
#
  distr  matrix
  first  random
  crow   1,    $1     , 1.00-$1
  crow   2,    1.00-$1, $1  
  number 20
#
show
wait return
  create
  run
exit
wait return
@plot.mac stack
exit   ! back to suite
#
kuplot
@kplot.mac stack
exit  ! back to suite
discus
#
LTEST_MAC = FALSE
if(n[1]==2000 .and. abs(cdim[1,1]+5.6666)<0.670 .and. abs(cdim[1,2]-4.6666)<0.670 .and. &
                    abs(cdim[2,1]+5.6666)<0.670 .and. abs(cdim[2,2]-4.6666)<0.670 .and. &
                    abs(cdim[3,1]+0.0000)<0.001 .and. abs(cdim[3,2]-9.5000)<0.001      ) then
  LTEST_MAC = TRUE
else
  eval n[1]
  eval              abs(cdim[1,1]+5.6666) ,     abs(cdim[1,2]-4.6666)
  eval              abs(cdim[2,1]+5.6666) ,     abs(cdim[2,2]-4.6666)
  eval              abs(cdim[3,1]+0.0000) ,     abs(cdim[3,2]-9.5000)
endif
exit
