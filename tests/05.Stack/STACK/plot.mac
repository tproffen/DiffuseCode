plot
  reset
  program   kuplot
  uvw       1, 1, 0
  abs       1,-1, 0
  ord       0, 0, 1
  ext       all
  vect      0,0,0
  thick     1.
  sel       all
  set       0,2,6, 1.0
  set       1,3,6, 1.0
exit
#
do i[3]=2,n[2]
  plot
    set  i[3],3,i[3], 1.0
  exit
enddo 
#
plot
  outf      $1.plot
  run
#  program   jmol   ! JMOL is interactive only; disabled for the test suite
  program   cif      ! writes the same CIF file without JMOL
  outf      $1.cif
  ext       all
  uvw       1,1,0
  abs       0,0,1
  ord       1,-1,0
  thick     1e9
#  run       plot:inter, kill:yes
  run
exit
