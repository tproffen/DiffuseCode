#@ HEADER
#@ NAME         stack.01.mac
#@ 
#@ KEYWORD      stacking fault, hexagonal, hcp, fcc
#@ 
#@ DESCRIPTION  This macro creates a simple structure with stacing faults
#@ DESCRIPTION  The basic types are hexagonal closed packed and cubic closed 
#@ DESCRIPTION  packed. No fourier is calcualted
#@
#@ PARAMETER    $0, 1
#@ PARAMETER    $1, real,  probability
#@
#@ USAGE        @stack.01 <probability>
#@
#@ END
################################################################################
#
discus
#
read
  cell  hexagonal.cell, 2, 2, 1
#
save
  outfile hexagonal.layer
  run
exit
#
stack
  layer  hexagonal.layer
  layer  hexagonal.layer
  trans  1,1, 1./3.,-1./3., 1./2
  trans  1,2,-1./3., 1./3., 1./2
  trans  2,1, 1./3.,-1./3., 1./2
  trans  2,2,-1./3., 1./3., 1./2
  distr  matrix
  first  random
  crow   1,    $1     , 1.00-$1
  crow   2,    1.00-$1, $1  
  number  4
#
  aver   0.00, 0.00, 1.00
  modul  1.00, 0.00, 0.00, 0.00, 1.00, 0.00
  set    modulus,on
  set    trans,fixed
#
  create
  run
exit
eval n[1]
eval n[2]
eval n[3]
eval n[4]
eval n[5]
eval n[6]
show mol,1
show mol, n[4]
wait return
@plot.mac stack
exit   ! back to suite
#
kuplot
@kplot.mac stack
exit  ! back to suite
