#@ HEADER
#@ NAME         stack.01.mac
#@ 
#@ KEYWORD      stacking fault, hexagonal, hcp, fcc
#@ 
#@ DESCRIPTION  This macro creates a simple structure with stacing faults
#@ DESCRIPTION  The basic types are hexagonal closed packed and cubic closed 
#@ DESCRIPTION  packed. No fourier is calcualted
#@
#@ PARAMETER    $0, 1
#@ PARAMETER    $1, real,  probability
#@
#@ USAGE        @stack.01 <probability>
#@
#@ END
################################################################################
#
discus
#
read
  stru types.list
save
  outfile internal.types.list
  write all
  run
exit
#
read
  cell  hexagonal.cell,10,10, 1
#
save
  outfile internal.hexagonal.layer
  write all
  run
exit
#wait return
#
#read
#  stru Kinternal.hexagonal.layer
chem
  elem
exit
show atom, 1
show atom, n[1]
wait return
#
stack
!  reset
  layer  internal.hexagonal.layer
  layer  internal.hexagonal.layer
  trans  1,1, 1./3.,-1./3., 1./2
  trans  1,2,-1./3., 1./3., 1./2
  trans  2,1, 1./3.,-1./3., 1./2
  trans  2,2,-1./3., 1./3., 1./2
  distr  list, types.list  
  first  random
#  crow   1,    $1     , 1.00-$1
#  crow   2,    1.00-$1, $1  
  number 1000
  number 12
#
  aver   0.00, 0.00, 1.00
  modul  1.00, 0.00, 0.00, 0.00, 1.00, 0.00
  set    modulus,on
  set    trans,fixed
#
  create
  run
exit
@plot.mac stack
exit   ! back to suite
#
kuplot
@kplot.mac stack
exit  ! back to suite
discus
#
# Test for Success
#
LTEST_MAC = FALSE
if(abs(x[1]+5)< 0.001 .and. abs(y[1]+5)<0.001. and. abs(z[1])<0.001) then
  echo COND 1
  if(abs(x[200]-4.33333)< 0.001 .and. abs(y[200]-4.66667)<0.001. and. abs(z[200]-0.5)<0.001) then
    echo COND 2
    if(abs(x[n[1]]-4.33333)< 0.001 .and. abs(y[n[1]]-4.66667)<0.001. and. abs(z[n[1]]-5.5)<0.001) then
      echo COND 3
     LTEST_MAC = TRUE
    endif
  endif
endif
exit   ! back to suite
