#
# generic parameter macro for diffev
# Is essentially replaced by the DIFFEV command 'newparam'
#
#  $1 : parameter number
#  $2 : parameter name
#  $3 : lower limit of paramter range
#  $4 : upper limit of paramter range
#  $5 : lower limit of initialization range
#  $6 : upper limit of initialization range
#
pop_name    $1,$2
pop_xmin[$1] =     $3
pop_xmax[$1] =     $4
pop_smin[$1] =     $5
pop_smax[$1] =     $6
pop_sig[$1]  =     0.001
pop_lsig[$1] =     0.0001
type real,$1
adapt   sigma,  1,0.2
adapt   lsig ,  1,0.02

