#set error,exit
#@ HEADER
#@ NAME         refine.mac.mac
#@
#@ KEYWORD      refinement, diffev, generic
#@
#@ DESCRIPTION  This macro runs a refinement loop
#@
#@ PARAMETER    $0, 0
#@
#@ USAGE        @refine.mac
#@
#@ END
#
################################################################################
#
diffev                        ! Switch to diffev section
#
  @cleanup.mac                ! Remove old files
#
  REF_NINDIV = 3
  @get_model.mac              ! Define the refinement model to use
  @diffev_setup.mac           ! Define refinement details
#
#
  init silent                 ! initialize all parameters, silently no files are written
  @parameter_fix.mac          ! A few parameters are intentionally fixed
#                             ! If 'init' is omitted, init will be done by run_mpi
#
#                             ! We now run a limited number of refinement cycles, during 
#                             ! which some parameters are fixed. 
#
  do i[0]=1,5! 200               ! Number of refinement cycles 
    echo "Loop GENERATION %4d %4d", i[0], REF_GENERATION
    !                         ! Run discus section with macro dis.diffev.mac, no repetitions
    run_mpi discus, dis.diffev.mac  , repeat:REF_NINDIV, logfile:LOGFILES/d, compute:serial
    compare silent            ! Compare R-values to previous generation
  enddo
#
  eval pop_xmin[5]
  eval pop_xmax[5]
  @parameter_release.mac      ! The fixed parameters are now opened for refinement
!  initialize 3, silent
  eval pop_v[3,1]
  eval pop_v[3,2]
  eval pop_t[3,1]
  eval pop_t[3,2]
  eval pop_v[5,1]
  eval pop_v[5,2]
  eval pop_t[5,1]
  eval pop_t[5,2]
  eval pop_xmin[5]
  eval pop_xmax[5]
  newpara P_alles, range[0,10], value:[1 , 9], status:free
  init 15
#
  echo "%c",par_name(5)
  echo "%4d",par_number('P_stack')

#
#                             ! Continue the refinement with the additional
#                             ! released parameters 
#
  do i[0]=1,5! 200               ! Number of refinement cycles 
    echo "Loop GENERATION %4d %4d", i[0], REF_GENERATION
    !                         ! Run discus section with macro dis.diffev.mac, no repetitions
    run_mpi discus, dis.diffev.mac  , repeat:REF_NINDIV, logfile:LOGFILES/d, compute:serial
    compare silent            ! Compare R-values to previous generation
  enddo
#
exit                          ! Back to suite
exit                          ! Finish the suite as well
