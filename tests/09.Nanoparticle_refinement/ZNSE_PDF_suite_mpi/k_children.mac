kuplot
reset
#
variable inte, gener
variable inte, kids
fclose all
fopen 1, GENERATION
fget 1, i[1],i[2], kids, i[4]
fclose 1
#
gener = $3
#
reset
kpar_par gener-1, $1, $2
skal
mark
plot
alloc rvalues, kids
alloc children, kids
do LOOP=1,kids
  fclose all
  fopen 1, "LOGFILES/Gen.%4D.Mem.%4D.KID.%4D",gener, LOOP, kids
  fget 1, y[n[1]-1, LOOP]
  i[0] = nint($1-1)
  do SLOW=1,i[0]
    fget 1
  enddo
  fget 1, x[n[1]-1,LOOP]
  x[n[1],LOOP]=x[n[1]-1,LOOP]
#
  fclose all
  fopen 1, "LOGFILES/Gen.%4D.Mem.%4D.KID.%4D",gener, LOOP, kids
  fget 1, r[0]
  i[0] = nint($2-1)
  do SLOW=1,i[0]
    fget 1
  enddo
  fget 1, y[n[1],LOOP]
  fclose all
enddo
kfra 1, 3, 4, 6
aver 
ltyp 6, 0
mtyp 6, 2
msiz 6, 0.7, 5
skal
mark
plot
wait return
kfra 1, 2, 5
skal
mark
mtyp 2, 3
ltyp 2, 0
msiz 2, 0.8, y
mtyp 5, 2
ltyp 5, 0
msiz 5, 0.8, y
mcol 5, black
plot
wait return
skal min(xmin[2],xmin[5]), max(xmin[2],xmax[5]),min(ymin[2],ymin[5])-0.1*(ymax[2]-ymin[2]), ymax[2] + (ymax[2]-ymin[2])
mark
plot
exit
