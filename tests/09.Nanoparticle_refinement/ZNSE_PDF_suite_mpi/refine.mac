diffev
variable integer, P_pop
variable integer, P_chd
if(P_pop==0) then
  P_pop =  10
endif
if(P_chd==0) then
  P_chd =  10
endif
#set error,exit
#@ HEADER
#@ NAME         refine.mac.mac
#@
#@ KEYWORD      refinement, diffev, generic
#@
#@ DESCRIPTION  This macro runs a refinement loop
#@
#@ PARAMETER    $0, 0
#@
#@ USAGE        @refine.mac
#@
#@ END
#
################################################################################
#
  reset
#
  @cleanup.mac                ! Remove old files
#
  @setup.mac                  ! Define number of individual repetitions
  @get_model.mac              ! Define the refinement model to use
  @diffev_setup.mac           ! Define refinement details
#
  init                        ! initialize all parameters, silently no files are written
#                             ! If 'init' is omitted, init will be done by run_mpi
#
  do i[0]=1,   4              ! Number of refinement cycles 
    echo "Loop GENERATION %4d %4d", i[0], REF_GENERATION
    !                         ! Run discus section with macro dis.diffev.mac, no repetitions
    run_mpi discus, dis.diffev.mac  , repeat:REF_NINDIV, logfile:LOGFILES/d, compute:serial
    compare                   ! Compare R-values to previous generation
#    if(bestr[1]< 0.168) then
#       break 2
#    endif
  enddo
  fopen 1, META/meta.log, append
  fput 1, P_pop, P_chd, i[0], diff_cr[1], diff_f[1]
  fclose all
exit                          ! Back to suite
exit                          ! Finish the suite as well
