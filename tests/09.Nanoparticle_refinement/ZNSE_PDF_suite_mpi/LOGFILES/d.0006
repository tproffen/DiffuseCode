 Resetting ..
 kuplot> exit
 discus>  
 discus> @global.mac
 discus>  
 discus>  
 discus>  
 discus>  
 discus> variable character, TMPDIR
 discus> variable character, INDIDIR
 discus> variable character, DATADIR
 discus> variable character, DATAFILE
 discus> variable character, SUBSTANCE
 discus>  
 discus>  
 discus>  
 discus> DATADIR   = "%c",'.'
 discus> DATAFILE  = "%c",'PD32ZS56.DAT'
 discus> INDIDIR   = "%c",'kuplot'
 discus> TMPDIR    = "%c",'internal'
 discus>  
 discus> SUBSTANCE = "%c",'znse_wurtzite'
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus> if('kuplot'/="%c",INDIDIR) then
 discus> fexist "%c/INDI", INDIDIR
 discus> if(res[1]==0) then
 discus> set error, live
 discus> system "mkdir -p %c/INDI", INDIDIR
 discus> set error,exit
 discus> endif
 discus> endif
 discus>  
 discus> if('.'/="%c",DATADIR) then
 discus> fexist "%c/DATA", DATADIR
 discus> if(res[1]==0) then
 discus> set error, live
 discus> system "mkdir -p %c/DATA", DATADIR
 discus> set error, exit
 discus> endif
 discus> endif
 discus> @get_model.mac
 discus>  
 discus>  
 discus>  
 discus>  
 discus> @aaa_model.mac
 discus>  
 discus>  
 discus>  
 discus> variable integer, PERFECT_SPHERE
 discus> variable integer, PERFECT_ELLIPSOID
 discus> variable integer, STACKED_SPHERE
 discus> variable integer, STACKED_ELLIPSOID
 discus> variable integer, model
 discus>  
 discus> PERFECT_SPHERE    = 1
 discus> PERFECT_ELLIPSOID = 2
 discus> STACKED_SPHERE    = 3
 discus> STACKED_ELLIPSOID = 4
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus> model = STACKED_ELLIPSOID
 discus> if(model == PERFECT_SPHERE .or. model == PERFECT_ELLIPSOID) then
 discus> REF_NINDIV = 1
 discus> endif
 discus>  
 discus> do indiv = 1, REF_NINDIV
 discus> @discus.znse.mac REF_KID
 discus>  
 discus>  
 discus>  
 discus> @variables.mac
 discus>  
 discus>  
 discus>  
 discus> variable real,  P_qmax
 discus>  
 discus> read
 discus> free P_lata, P_lata, P_latc, 90.00, 90.00, 120.00, P63mc
 discus> insert Zn, 1./3., 2./3., P_z_zn, P_biso
 discus> insert Se, 1./3., 2./3., 0.0000, P_biso
 discus>  
 discus>  
 discus>  
 discus> if(model == PERFECT_SPHERE .or. model == PERFECT_ELLIPSOID) then
 discus> P_stack  = 1.00
 discus> endif
 discus>  
 discus>  
 discus>  
 discus>  
 discus> if(model == PERFECT_SPHERE .or. model == STACKED_SPHERE) then
 discus> P_cc_dia     = P_ab_dia
 discus> endif
 discus>  
 discus> P_qmax      = 30.00
 discus>  
 discus> echo " save in DISCUS_MAIN"
 discus> save
 discus> outfile "%c/STRU/%c.%4D.%4D.cell", TMPDIR,SUBSTANCE,REF_KID,indiv
 discus> write all
 discus> run
 discus> exit
 discus>  
 discus>  
 discus>  
 discus> echo " INTO MAKELAYERS    "
 discus> @makelayers.mac
 discus>  
 discus>  
 discus> variable integer,width
 discus> variable real, thick
 discus> width = int(2.5 * P_ab_dia/P_lata       )
 discus>  
 discus> echo " READ %c/STRU/%c.%4D.%4D.cell",TMPDIR,SUBSTANCE,REF_KID,indiv
 discus> read
 discus> cell "%c/STRU/%c.%4D.%4D.cell",TMPDIR,SUBSTANCE,REF_KID,indiv,width,width,2
 discus> echo " DID READ"
 discus> thick = blen(0.0, 0.0, 0.5-P_z_zn) + 0.1
 discus>  
 discus> surface
 discus> boundary hkl, 0, 0, 1,   0.5,inside
 discus> boundary hkl, 0, 0,-1, thick,inside
 discus> exit
 discus> purge
 discus>  
 discus>  
 discus> echo " SAVING LAYERS "
 discus> save
 discus> outf "%c/STRU/%c.%4D.%4D.layer",TMPDIR,SUBSTANCE,REF_KID,indiv
 discus> write all
 discus> run
 discus> exit
 discus>  
 discus>  
 discus>  
 discus> symm
 discus> angle 180.0
 discus> type  proper
 discus> mode  repl
 discus> sel   all
 discus> incl  all
 discus> orig  0.333333, 0.666667, 0.00
 discus> uvw   0,0,1
 discus> trans 0.00, 0.00, 0.00
 discus> run
 discus> exit
 discus>  
 discus>  
 discus> echo " SAVING LAYERS rotated"
 discus> save
 discus> outf "%c/STRU/%c.%4D.%4D.rotated",TMPDIR,SUBSTANCE,REF_KID,indiv
 discus> run
 discus> exit
 discus>  
 discus>  
 discus> @shape.ellipsoid.mac
 discus> read
 discus> cell "%c/STRU/%c.%4D.%4D.cell",TMPDIR,SUBSTANCE,REF_KID,indiv
 discus>  
 discus> echo " STRT STACK in SHAPE_ELLIPSOID"
 discus> @stack.mac P_stack
 discus>  
 discus>  
 discus>  
 discus> variable integer,height
 discus> height = int(2.*P_cc_dia/lat[3] + 2)
 discus>  
 discus> stack
 discus> layer "%c/STRU/%c.%4D.%4D.layer"  ,TMPDIR,SUBSTANCE,REF_KID,indiv
 discus> layer "%c/STRU/%c.%4D.%4D.rotated",TMPDIR,SUBSTANCE,REF_KID,indiv
 discus> trans  1,1, -0.3333, 0.3333, 0.5000
 discus> trans  1,2,  0.3333,-0.3333, 0.5000
 discus> trans  2,1, -0.3333, 0.3333, 0.5000
 discus> trans  2,2,  0.3333,-0.3333, 0.5000
 discus> sigma  1,1,  0.0000, 0.0000, 0.0000
 discus> sigma  1,2,  0.0000, 0.0000, 0.0000
 discus> sigma  2,1,  0.0000, 0.0000, 0.0000
 discus> sigma  2,2,  0.0000, 0.0000, 0.0000
 discus> aver   0.00, 0.00, 1.00
 discus> modu   1.00, 0.00, 0.00,  0.00, 1.00, 0.00
 discus> set mod ,on
 discus> set trans,fixed
 discus>  
 discus> random prob,0.00
 discus> random offset, 0.00, 0.00, 0.00
 discus> random sigma , 0.00, 0.00, 0.00
 discus>  
 discus> rotate status,off
 discus>  
 discus> distr  matrix
 discus>  
 discus> number height
 discus>  
 discus> crow   1,       P_stack    ,1.00-P_stack
 discus> crow   2,  1.00-P_stack    ,     P_stack
 discus>  
 discus>  
 discus> create
 discus> run
 discus> exit
 discus>  
 discus> surface
 discus> boundary ellipsoid, P_ab_dia, P_ab_dia, P_cc_dia, centx:0.0,centy:0.0,centz:P_cc_dia*0.5/P_latc
 discus> exit
 discus>  
 discus> purge
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus>  
 discus> @pdf.mac REF_KID,indiv
 discus> @setup_pdf.mac
 discus> variable real,pdf_range
 discus> variable real,pdf_step
 discus>  
 discus> pdf_range = 32.08
 discus> pdf_step  =  0.02
 discus>  
 discus> pdf
 discus>  
 discus> ides all
 discus> jdes all
 discus> isel all
 discus> jsel all
 discus>  
 discus> set bound,    crystal, exact
 discus> set dens,     P_density
 discus> set corrlin,  P_corrlinear
 discus> set corrquad, P_corrquad
 discus> set srat,     P_srat,3.5
 discus> set therm,    gauss
 discus> set qbroad,   P_qbroad
 discus> set qdamp,    P_qdamp
 discus> set qmax,     P_qmax
 discus> set rad,      xray
 discus> set range,    pdf_range+5.0, 0.01
 discus>  
 discus> set weig,     P_scale
 discus> set finite,   periodic
 discus>  
 discus>  
 discus> calc
 discus> save pdf,"%c/INDI/indi.%4D.%4D"  ,INDIDIR, REF_KID, indiv
 discus> echo     "%c/INDI/indi.%4D.%4D"  ,INDIDIR, REF_KID, indiv
 discus> exit
 discus>  
 discus> enddo
