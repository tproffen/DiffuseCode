#
#  If the nanoparticles contain stacking faults, we need to 
#  repeat the simulation REF_NINDIV times and average the corresponding 
#  pattern(powder/pdf) prior to comparison to the experimental 
#  data
#
REF_NINDIV  =   3 !20
INDI_PARALLEL =   $1
#
if(REF_NINDIV == 1 .or. MPI==MPI_OFF) then
   INDI_PARALLEL = FALSE
endif
