#
#  global.mac
#
#  define file names
#
variable character, TMPDIR    ! temporary DISCUS files   'internal'     or '.'
variable character, INDIDIR   ! temporary PDF directory  'kuplot'       or 'TEMP'
variable character, DATADIR   ! input data directory     '/tmp/mpkr04/' or. '.'
variable character, DATAFILE  ! Input Data File  
variable character, SUBSTANCE ! Substance name  
#
# LOCAL Version, serial and parallel
#
#DATADIR  = "%c",'.'
#DATAFILE = "%c",'PD32ZS56.DAT'
#INDIDIR  = "%c",'kuplot'
#TMPDIR   = "%c",'internal'
#SUBSTANCE = "%c",'znse_wurtzite'
#
# High performance compute center individuals in parallel
#
DATADIR  = "%c",'/tmp/mpkr04'      ! Make sure these are unique
DATAFILE = "%c",'PD32ZS56.DAT'
INDIDIR  = "%c",'/tmp/mpkr04'      ! Make sure these are unique
TMPDIR   = "%c",'internal'
SUBSTANCE = "%c",'znse_wurtzite'
#
# High performance compute center individuals serially
#
#DATADIR  = "%c",'/tmp/mpkr04'      ! Make sure these are unique
#DATAFILE = "%c",'PD32ZS56.DAT'
#INDIDIR  = "%c",'kuplot'
#TMPDIR   = "%c",'internal'
#
if(REF_NINDIV==1 .or. PROGRAM==DISCUS .and. INDI_PARALLEL==FALSE .or. PROGRAM==KUPLOT .and. MPI_FIRST==TRUE) then   ! serial calculation of individuals
   INDIDIR  = "%c",'kuplot'
else
   INDIDIR  = "%c",'/tmp/mpkr04'
endif
echo " INDIDIR %c ", INDIDIR
#
#
# Create necessary directories
#
if('kuplot'/="%c",INDIDIR) then         ! Test for INDIDIR
  fexist "%c/INDI", INDIDIR
  if(res[1]==0) then
    set error, live
    system "mkdir -p %c/INDI", INDIDIR
    set error,exit
  endif
endif
#
if('.'/="%c",DATADIR) then              ! Test for DATADIR
  fexist "%c/DATA", DATADIR
  if(res[1]==0) then
    set error, live
    system "mkdir -p %c/DATA", DATADIR
    set error, exit
  endif
endif
