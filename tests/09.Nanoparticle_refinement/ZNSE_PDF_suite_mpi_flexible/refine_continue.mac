#set prompt,redirect
#set error,exit
#@ HEADER
#@ NAME         diffev.mac.mac
#@
#@ KEYWORD      refinement, diffev, generic
#@
#@ DESCRIPTION  This macro continues a refinement loop
#@
#@ PARAMETER    $0, 0
#@
#@ USAGE        @diffev
#@
#@ END
#
################################################################################
#
diffev
#
@setup.mac
#
do i[0]=1, 5  ! 50 !0
echo "Loop, GENERATION %4d %4d",i[0]-1, pop_gen[0]
  run_mpi discus, dis.diffev.mac  , 0     , LOGFILES/d ! /dev/null ! LOGFILES/d
  compare silent
enddo
exit
exit
