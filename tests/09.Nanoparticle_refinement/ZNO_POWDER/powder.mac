#
#  powder.mac
#
################################################################################
#
#  calculates the powder pattern via the Debye equation
#
################################################################################
#
#powder               ! Swithc to the powder menu
#    xray             ! Set the calculation for X-rays
#    set axis,q       ! Calculate on an equally spaced grin in Q, this is the
#                     ! fastest mode!
#    set calc,debye   ! Use the Deby equation instead of integration mode
#    set disp,off     ! Do not use anomalous dispersion
#    set delta,0.0    ! Do not use convolution by a simple Gaussian
#    set qmin,1.4000  ! Calculate from Q(min)
#    set qmax,7.1000  ! to Q(max)
#    set dq,  0.0005  ! in eual steps of deltaQ
#    set temp,use     ! Use the Debye-Waller factor 
#    set wvle,1.54056 ! Set the wave length
#    set four,four    ! Make sure the standard fourier is used (there is a
#                     ! special version for singel crystals with stacking faults)
#    set lpcor,bragg,26.58  ! Set Lorentz-Polarisation for a Bragg-Brenanto
#                     ! Diffractometer
#    run              ! Execute the calculation
#  exit               ! Go back to the main DISCUS menu
#  
powder
  xray
  set axis,q
  set calc,debye 
  set disp,off
  set delta,0.0
  set qmin,0.8000
  set qmax,8.0000
  set dq,  0.005
  set temp,use  
  set profile, pseudo
  set profile, eta, 0.5
  set profile, uvw, 0.0000,  0.0000,  0.0010
  set profile, off
  set wvle,1.54000
  set four,four
  set lpcor,bragg,26.58
  run
exit
