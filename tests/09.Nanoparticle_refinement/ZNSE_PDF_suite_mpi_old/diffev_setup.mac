#
variable  integer,ipar
#
pop_gen[1]  =   0
#
pop_n[1]    =   9!1
pop_c[1]    =   9!1
pop_dimx[1] =  14
#
#  1 lattice constant a
#
ipar =  1
@diffev_para.mac  ipar, lata  , 3.9000,  4.020,  3.980, 3.990
#
#  2 lattice constant c
#
ipar =  ipar + 1
@diffev_para.mac  ipar, latc  , 6.4900,  6.570,  6.490, 6.510
#
#  3 z value Zn
#
ipar =  ipar + 1
@diffev_para.mac  ipar, z_zn  , 0.3600,  0.450,  0.373, 0.380
#
#  4 B value   
#
ipar =  ipar + 1
@diffev_para.mac  ipar, biso  , 0.0100,  2.500,  0.700, 0.900
#
#  5 stacking fault property
#
ipar =  ipar + 1
@diffev_para.mac  ipar, stack , 0.0000,  1.000,  0.700, 0.800
#
#  6 diameter in ab plane
#
ipar =  ipar + 1
@diffev_para.mac  ipar, ab_dia, 5.0000, 30.000, 25.000, 30.00
#
#  7 diameter along c-axis
#
ipar =  ipar + 1
@diffev_para.mac  ipar, cc_dia, 5.0000, 40.000, 32.000, 40.00
#
################################################################################
#
#
#  8 Quadratic correlation term
#
ipar =  ipar + 1
@diffev_para.mac  ipar, quad  , 0.0000,  0.000,  0.000,  0.00
#
#  9 Linear correlation term
#
ipar =  ipar + 1
@diffev_para.mac  ipar, linear, 0.0005,  0.100,  0.044,  0.051
#
# 10 Qbroadening = Qalpha
#
ipar =  ipar + 1
@diffev_para.mac  ipar, qbroad, 0.00357,  0.00357,  0.00357,  0.00357
#
# 11 Qdamping = QSIG
#
ipar =  ipar + 1
@diffev_para.mac  ipar, qdamp , 0.02078,  0.02078,  0.02078,  0.02078
#
# 12 srat 
#
ipar =  ipar + 1
@diffev_para.mac  ipar, srat  , 1.0000,  1.000,  1.000, 1.000
#
# 13 density 
#
ipar =  ipar + 1
@diffev_para.mac  ipar, dens  , 0.0000,  0.000,  0.000, 0.000
#
# 14 pdf scale factor 
#
ipar =  ipar + 1
@diffev_para.mac  ipar, scale , 0.0001,  4.000,  2.200, 2.450
#newpara scale , 0.0001,  4.000,  2.200, 2.450
#
diff_cr[1]  = 0.9
diff_f[1]   = 0.81
diff_lo[1]  = 0.0
diff_k[1]   = 1.0
#
refine      none
refine      1,  2,  3,  4,  5,  6,  7
refine      9,         14
#
donor      random
#selection  compare
selection  best,all
#
trialfile  silent
restrial   silent
lastfile   DIFFEV/Current
logfile    DIFFEV/Parameter
summary    DIFFEV/Summary
#
backup TEMP/calc, FINAL/final
