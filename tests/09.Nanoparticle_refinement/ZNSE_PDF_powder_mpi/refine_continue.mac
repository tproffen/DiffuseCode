#set prompt,redirect
#set error,exit
#@ HEADER
#@ NAME         diffev.mac.mac
#@
#@ KEYWORD      refinement, diffev, generic
#@
#@ DESCRIPTION  This macro continues a refinement loop
#@
#@ PARAMETER    $0, 0
#@
#@ USAGE        @diffev
#@
#@ END
#
################################################################################
#
diffev
variable integer, P_pop
variable integer, P_chd
P_pop = 20
P_chd = 20
#
@setup.mac
#
read
run_mpi discus, dis.diffev.mac  , repeat:REF_NINDIV, compute:serial, logfile:LOGFILES/d 
compare silent
#constraint P_u*01.00**2+P_v*01.00+P_w > 0.0
#constraint P_u*15.00**2+P_v*15.00+P_w > 0.0
#constraint P_u*30.00**2+P_v*30.00+P_w > 0.0
release P_corrquad, range:0.007, value:0.021,min:0.00,max:0.12, dismiss:best
#
do i[0]=1, 200
echo "Loop, GENERATION %4d %4d",i[0]-1, pop_gen[0]
  run_mpi discus, dis.diffev.mac  , repeat:REF_NINDIV, compute:serial, logfile:LOGFILES/d 
  compare silent
enddo
exit
exit
