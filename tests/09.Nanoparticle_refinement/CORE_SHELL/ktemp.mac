#
rese
#
#
variable integer,generation
variable integer,member
variable integer,children
variable integer,parameters
variable integer,kid
#
kid = $1
#
@setup
#
# calculate all R-values;
#
#
  if(mode.eq.linear) then
    load xy,DATA/pd361.dat
  elseif(mode.eq.square) then
    load xy,DATA/pd361_r.dat
  endif
  load xy,"TEMP/calc.%4D.pdf",kid
#
#  match scal,1,2
  skal
#
  kcal sub,1,2
  ccal add,wy,3,-15
#
mtyp 1,0
mtyp 2,0
mtyp 3,0
ltyp 1,1
ltyp 2,1
ltyp 3,1
lcol 1,3
lcol 2,1
lcol 3,6
skal
mark 2,5
plot
  rval 1,2,one
ccal add,wy,1,15
ccal add,wy,2,15
rval 1,2,one
wait return
ccal add,wy,1,-15
ccal add,wy,2,-15
 skal 1,12
mark
plot
