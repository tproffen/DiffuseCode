variable integer,generation
variable integer,member
variable integer,children
variable integer,parameters
variable integer,kid
#
kid = $1
#
@setup
#
fclose all
#
fopen 1,GENERATION
fget  1,generation,member,children,parameters
fclose 1
#
#  Read parameter values
#
fopen 1,"DIFFEV/Versuche.%4D",kid
fget 1
fget 1
fget 1
fget 1
fget 1
do i[0]=1,parameters
  fget 1,r[100+i[0]]
enddo
fclose 1
#
# calculate all R-values;
#
#
  if(mode.eq.linear) then
    load xy,DATA/pd361.dat
  elseif(mode.eq.square) then
    load xy,DATA/pd361_r.dat
  endif
  load xy,"FINAL/final.%4D.pdf",kid
#
#  match scal,1,2
  skal
#
  kcal sub,1,2
  ccal add,wy,3,-15
#
mtyp 1,0
mtyp 2,0
mtyp 3,0
ltyp 1,1
ltyp 2,1
ltyp 3,1
lcol 1,3
lcol 2,1
lcol 3,6
skal
mark 2,5
plot
  rval 1,2,one
