DATADIR  = "%c",'.'
DATAFILE = "%c",'znse-mn.limited'
INDIDIR  = "%c",'kuplot'
TMPDIR   = "%c",'.' !internal'
SUBSTANCE = "%c",'znse_wurtzite'
