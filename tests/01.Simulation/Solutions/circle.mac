#@ HEADER
#@ NAME         circle.mac
#@ 
#@ KEYWORD      loop, circle, simple
#@ 
#@ DESCRIPTION  This macro creates a cricle of atoms
#@
#@ PARAMETER    $0, 2
#@ PARAMETER    $1, real,       radius of circle
#@ PARAMETER    $2, integer,    number of atoms
#@
#@ USAGE        @modify  <radius>, <number>
#@
#@ END
#
################################################################################
#
# Solution to first homework, creation of a circle
#
################################################################################
#
# variable real, radius    ! define a variable name, floating type variable
# variable real, angle     !
# variable integer,number  ! define a variable name, integer number type variable
# variable integer,counter !
# #
# radius = $1              ! set the radius to the value of 1.st parameter
# number = $2              ! set the number of points to the value of 2.nd parameter
# angle  = 360./number     ! calculate incremental angle
# #
# read                     ! switch to reading menu
#   free  1,1,1,90,90,90   ! define a user defined space, here cartesian space
# do counter = 1,number    ! perform a loop from 1 to number
#   insert Zr, radius*cosd(counter*angle),radius*sind(counter*angle),0.0
#                          ! insert a Zr atom at the points along the circle
#                          ! coordinates are       ( cosd(counter*angle) )
#                          !                       ( cosd(counter*angle) )
#                          ! coordinates are       ( cosd(counter*angle) )
# enddo                    ! end of commands within the loop
#
# @plot circle             ! write atoms for plotting
#
################################################################################
#
discus
#
variable real, radius
variable real, angle
variable integer,number
variable integer,counter
#
radius = $1
number = $2
angle  = 360./number
#
read
  free  1,1,1,90,90,90
do counter = 1,number
  insert Zr, radius*cosd(counter*angle),radius*sind(counter*angle),0.0
enddo
#
@plot.mac circle
#
branch kuplot
   @kplot.mac circle
   exit
exit
