#
#  kplot.mac
#
################################################################################
#
#  Plots a projection of a crystal structure with KUPLOT
#
#  rese                       ! Reset kuplot 
#  load cr, $1.plot           ! load the data set as crystal coordinates 
#  aver 1                     ! Define the ratio between the axes lengths
#  skal xmin[1]-0.5,xmax[1]+0.5,ymin[1]-0.5,ymax[1]+0.5
#                             ! Automatic scaling of the plot area
#  mark                       ! Automatic distances between markers along axes
#  fnam off                   ! Turn filename off
#  tit1 Crystal structure     ! Write the title line 1
#  tit2 2-D section           ! Write the title line 2
#  achx [x 0 0]               ! Write information along x-axis
#  achy [0 y 0]               ! Write information along y-axis
#  msize 1,0.5                ! Define the marker size for data set 1 to 0.5
#  plot                       ! Draw the actual plot
#
################################################################################
#
rese
load cr, $1.plot
aver 1
skal xmin[1]-0.5,xmax[1]+0.5,ymin[1]-0.5,ymax[1]+0.5
mark
fnam off
tit1 Crystal structure
tit2 2-D section
achx [x 0 0]
achy [0 y 0]
msize 1,0.5
plot
