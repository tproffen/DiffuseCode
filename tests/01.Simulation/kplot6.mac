#
#  kplot6.mac
#
################################################################################
#
#  plots a structure with hexagonal lattice constants
#
################################################################################
#
rese
load cr, $1.plot
aver 1
angle 120
skal xmin[1]-0.5,xmax[1]+0.5,ymin[1]-0.5,ymax[1]+0.5
mark
fnam off
tit1 Crystal structure
tit2 2-D section
achx [x 0 0]
achy [0 y 0]
msize 1,0.5
plot
