kuplot
reset
load xy, fort.98, 1, 2
load xy, fort.98, 1, 3
load xy, fort.98, 1, 4
load xy, fort.98, 1, 5
load xy, fort.98, 1, 6
#
r[0] =    min(ymin[1], ymin[2], ymin[3],ymin[4], ymin[5])
r[1] =    max(ymax[1], ymax[2], ymax[3],ymax[4], ymax[5])
skal 0,1, r[0], r[1]
mark 0.1
fnam off
lcol 1, blue
lcol 2, red
lcol 3, black
lcol 4, green
lcol 5, darkyellow
sann 1,  BLUE  : Diff  , 0.5, r[0] + 0.95*(r[1]-r[0])
sann 2,  RED   : Change, 0.5, r[0] + 0.90*(r[1]-r[0])
sann 3,  BLACK : Prop  , 0.5, r[0] + 0.85*(r[1]-r[0])
sann 4,  GREEN : Inte  , 0.5, r[0] + 0.80*(r[1]-r[0])
sann 5,  DRK GR: Deriv , 0.5, r[0] + 0.75*(r[1]-r[0])
plot
exit
