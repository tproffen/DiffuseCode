rese
#
load ni,example5.inte
load xy,cucu.hist
load xy,cuau.hist
load xy,auau.hist
#
nfra 3
sfra 1, 0.00, 0.30, 0.54, 1.00
sfra 2, 0.48, 0.30, 1.00, 1.00
sfra 3, 0.30, 0.00, 1.00, 0.30
#
kfra 1,1
kfra 2,2,3,4
kfra 3,example5.data
#
fopen 1,example5.hist
fget 1,r[10],r[11]
fget 1,r[13],r[14]
fget 1,r[16],r[17]
fclose 1
#
afra 1
  buff 0.06,0.06,0.10,0.00
  aver 1
  angle 90
  achx [ H 0 0 ]
  achy [ 0 K 0 ]
  hart 1,2
  cmap fire
  hlin 1,1e7,1e7,20
  hlin 1, 5., 5., 20, %
  tit1 
  tit2 
  fnam off
  achz OFF
#
afra 2
  buff 0.06,0.06,0.10,0.00
  r[20] = min(r[10],min(r[13],r[16]))
  r[21] = max(r[10],max(r[13],r[16]))
  r[22] = max(r[11],max(r[14],r[17]))
  aver 
  skal r[20]- 5.*r[22],r[21]+ 5*r[22],0,max(ymax[1],max(ymax[2],ymax[3]))*1.025
  mark 0.2  
  fnam off
  tit1 
  tit2 
  achx r [\A]
  achy number 
  fset -3
#
afra 3
  font size,5,20
plot
