plot
  reset
  program   kuplot
  uvw       0, 0, 1
  abs       1, 0, 0
  ord       0, 1, 0
  ext       all
  vect      0,0,0
  thick     1.
  sel       all
  set       0,2,6, 1.0
  set       1,3,3, 1.0
exit
#
do i[3]=2,n[2]
  plot
    set  i[3],3,i[3], 1.0
  exit
enddo 
#
plot
  outf      $1.plot
  run
exit
