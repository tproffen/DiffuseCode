kuplot
#
reset
load cr, PLOT/primitive.plot
#
aver 1
fset 2
grid on
skal xmin[1]-0.3,xmin[1]+3.30,ymin[1]-0.3, ymin[1]+3.30
mark 1,1
msiz 1,2.0
sann  1, 1, 0.95,0.95
sann  2, 2, 1.25,1.25
sann  3, 3, 1.95,0.95
sann  4, 4, 2.25,1.25
sann  5, 5, 2.95,0.95
sann  6, 6, 3.25,1.25
#
sann  7, 7, 0.95,1.95
sann  8, 8, 1.25,2.25
sann  9, 9, 1.95,1.95
sann 10,10, 2.25,2.25
sann 11,11, 2.95,1.95
sann 12,12, 3.25,2.25
#
sann 13,13, 0.95,2.95
sann 14,14, 1.25,3.25
sann 15,15, 1.95,2.95
sann 16,16, 2.25,3.25
sann 17,17, 2.95,2.95
sann 18,18, 3.25,3.25
font size, 3,18
font size, 4,18
font size, 6,18
achx
achy
tit1
tit2
fnam off
plot
save png, number_scheme_perfect.png
wait return
alloc circle,2
variable real,alpha
x[2,1] = 3.30
y[2,1] = 1.00
x[2,2] = 2.00
y[2,2] = 3.50
lcol 2,6
sann  1, 1, 0.95,0.95
sann  2, 2, 1.25,1.25
sann  3, 3, 1.95,0.95
sann  4, 4, 2.25,1.25
sann  5, 5, 2.95,0.95
sann  6,OFF
#
sann  7, 6, 0.95,1.95
sann  8, 7, 1.25,2.25
sann  9, 8, 1.95,1.95
sann 10, 9, 2.25,2.25
sann 11,OFF
sann 12,OFF
#
sann 13,10, 0.95,2.95
sann 14,11, 1.25,3.25
sann 15,12, 1.95,2.95
sann 16,OFF
sann 17,OFF
sann 18,OFF
plot
save png, number_scheme_purged.png
wait return
reset
load cr, PLOT/cut.plot
#
aver 1
fset 2
grid on
skal xmin[1]-0.3,xmin[1]+3.30,ymin[1]-0.3, ymin[1]+3.30
mark 1,1
msiz 1,2.0
sann  1, 1, 0.95,0.95
sann  2, 2, 1.25,1.25
sann  3, 3, 1.95,0.95
sann  4, 4, 2.25,1.25
sann  5, 5, 2.95,0.95
sann  6, 6, 3.25,1.25
#
sann  7, 7, 0.95,1.95
sann  8, 8, 1.25,2.25
sann  9, 9, 1.95,1.95
sann 10,10, 2.25,2.25
sann 11,11, 2.95,1.95
sann 12,12, 3.25,2.25
#
sann 13,13, 0.95,2.95
sann 14,14, 1.25,3.25
sann 15,15, 1.95,2.95
sann 16,16, 2.25,3.25
sann 17,17, 2.95,2.95
sann 18,18, 3.25,3.25
font size, 3,18
font size, 4,18
font size, 6,18
achx
achy
tit1
tit2
fnam off
alloc circle,2
variable real,alpha
x[2,1] = 3.30
y[2,1] = 1.00
x[2,2] = 2.00
y[2,2] = 3.50
lcol 2,6
lwidt 2, 0.8
plot
save png, number_scheme_cut.png
wait return
reset
load cr, PLOT/purged.plot
#
aver 1
fset 2
grid on
skal xmin[1]-0.3,xmin[1]+3.30,ymin[1]-0.3, ymin[1]+3.30
mark 1,1
msiz 1,2.0
alloc circle,2
variable real,alpha
x[2,1] = 3.30
y[2,1] = 1.00
x[2,2] = 2.00
y[2,2] = 3.50
lcol 2,6
sann  1, 1, 0.95,0.95
sann  2, 2, 1.25,1.25
sann  3, 3, 1.95,0.95
sann  4, 4, 2.25,1.25
sann  5, 5, 2.95,0.95
sann  6,OFF
#
sann  7, 6, 0.95,1.95
sann  8, 7, 1.25,2.25
sann  9, 8, 1.95,1.95
sann 10, 9, 2.25,2.25
sann 11,OFF
sann 12,OFF
#
sann 13,10, 0.95,2.95
sann 14,11, 1.25,3.25
sann 15,12, 1.95,2.95
sann 16,OFF
sann 17,OFF
sann 18,OFF
plot
save png, number_scheme_purged.png
#
exit  ! backto suite
