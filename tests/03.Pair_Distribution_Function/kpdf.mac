#
#  kpdf.mac
#
################################################################################
#
#  plots the results of the pdf calculations
#  version for a single dataset
#
################################################################################
#
# Basic error handling
#
if($0 /= 1) then
  echo
  echo "Usage:"
  echo "@kpdf <number>"
  echo
# wait return
  continue kuplot
endif
#
rese                    # Set KUPLOT to initial values
load xy, therm.$1.pdf   # load a data set in 2-column format 
skal                    # automatically scale the picture
mark                    # automatically set distances for markers along axes
ltyp 1,1                # set line type for data set 1 to 1 (solid line)
mtyp 1,0                # set marker type for data set 1 to 0 (= off)
achx r[\A]              # set text along x-axis
achy G(r)               # set text along y-axis
fnam off                # do not display the file name
tit1 "Model no. %d",$1  # title line
if($1 == 1) then
   sann 1,"No Qmax, no thermal",0.3,ymax[1]*0.8
   sann 2, OFF
elseif($1 == 2) then
   sann 1,"Qmax=35A, no thermal",0.3,ymax[1]*0.8
   sann 2, OFF
elseif($1 == 3) then
   sann 1,"No Qmax, thermal convolution",0.3,ymax[1]*0.8
   sann 2, OFF
elseif($1 == 4) then
   sann 1,"No Qmax, thermal convolution",0.3,ymax[1]*0.8
   sann 2,"1/r dependent width    ",0.3,ymax[1]*0.7
elseif($1 == 5) then
   sann 1,"No Qmax, no thermal ",0.3,ymax[1]*0.8
   sann 2,"individual atoms moved",0.3,ymax[1]*0.70
elseif($1 == 6) then
   sann 1,"Qmax=35A, no thermal ",0.3,ymax[1]*0.8
   sann 2,"individual atoms moved",0.3,ymax[1]*0.70
elseif($1 == 7) then
   sann 1,"Qmax=35A, thermal convolution",0.3,ymax[1]*0.8
   sann 2, OFF
else
   sann 1, OFF
   sann 2, OFF
endif
plot                    # do the actual plot
