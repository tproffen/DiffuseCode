#
# get_oxygen.mac
#
#   $1 absolute site no of oxygen
#   $2 shift in x unit cells
#   $3 shift in y unit cells
#   $4 shift in z unit cells
#   $5 site of central metal atom
#   $6 central atom number
#
#   Vector i[10*] is the unit cell number of the central atom
#   Vector i[20*] is the unit cell number of the current neighbor
#   Vector r[30*] is the atom coordinate of the current neihbor shifted to be around 0,0,0
#   Vector r[20*] is the compounded position of all neighbors
#
   i[201] = mod( i[101] + $2    + ncellx - 1, ncellx) + 1   ! [  0   0   0 ]
   i[202] = mod( i[102] + $3    + ncelly - 1, ncelly) + 1
   i[203] = mod( i[103] + $4    + ncellz - 1, ncellz) + 1
   index2cell i[201], i[202],i[203], $1
#show atom, nint(res[1])
   r[301] = x[nint(res[1])]  - (i[201] - 1) + $2  ! shift atom close to 0,0,0
   r[302] = y[nint(res[1])]  - (i[202] - 1) + $3  ! by subtracting vector to
   r[303] = z[nint(res[1])]  - (i[203] - 1) + $4  ! unit cell origin, add relative shift($2,$3,$4)
#echo " %5.2f  %5.2f  %5.2f",r[301],r[302],r[303]
   r[201] = r[201] + r[301]
   r[202] = r[202] + r[302]
   r[203] = r[203] + r[303]
