#
#@ HEADER
#@ NAME         dom.perov.mac
#@ 
#@ KEYWORD      domain, cube, pseudoatom
#@ 
#@ DESCRIPTION  This macro creates a Perovskite structure. 
#@ DESCRIPTION  The simulation involves several steps:
#@ DESCRIPTION  1. dummy atoms are sorted, each dummy atom
#@ DESCRIPTION  represents a unit cell.
#@ DESCRIPTION  2. The distances between the dummy atoms are relaced
#@ DESCRIPTION  3. The dummy atoms are replaced by individual unit cells
#@
#@ PARAMETER    $0, 0
#@
#@ USAGE        @dom.perov 
#@
#@ END
################################################################################
#
discus
reset
#
variable integer,dimenx
variable integer,dimeny
variable integer,dimenz
variable real,ratio
#
ratio = 1.0015
dimenx = 120
dimeny = 120
dimenz =  1 
#
@dom.perov.make.mac
#
read
  cell dummy.perov.cell,dimenx,dimeny,dimenz
#
replace d100,d010,all,1./3.
replace d100,d001,all,1./2.
if(dimenz==1) then
  chem
    elem
    set mode,period,quick,xy
  exit
else
  chem
    elem
    set mode,period,quick
  exit
endif
#
@plot.mac dom.perov.random
#
@dom.perov.sort.mac
@plot.mac dom.perov.sorted
@dom.perov.relax.mac
@plot.dummy.sphere.mac dom.perov.relaxed
@dom.perov.fourier.mac dom.perov.relaxed
save
  outf dom.perov.relaxed.list
  write ncell
  run
exit
@dom.perov.replace.mac dom.perov.relaxed
show adp:all
wait return
chem
  elem
  wait return
exit
#show config
#wait return
purge 
chem
  set crystal, dimenx,dimeny,dimenz, 5 
  set mode, quick, period
exit
show adp:all
@dom.perov.fourier.mac dom.perov.final
#
if(dimenz==1) then
branch kuplot
   @k.perov.mac
   exit
endif
#
exit     ! back to suite
kuplot
#
#  Test for Success
#
load ni, RESULTS/dom.perov.final.inte
match sca, 2, 1
rval 1, 2, one
r[0] = res[1]
LTEST_MAC = FALSE
if(z[1, 148, 101]>z[1, 148, 103]) then
  echo COND 1  
! if(z[1,150,101]/z[1,137,137]> 200) then
!   echo COND 2
    if(r[0]< 0.85) then
    echo COND 3
    LTEST_MAC = TRUE
    endif
! endif
endif
exit
