#
#
therm
mmc
  reset
  set vec, rese
  set nei, rese
#
  set vec,  1,  1, 1,   1,  0,  0
  set vec,  2,  1, 1,  -1,  0,  0
  set vec,  3,  1, 1,   0,  1,  0
  set vec,  4,  1, 1,   0, -1,  0
  set vec,  5,  1, 1,   0,  0,  1
  set vec,  6,  1, 1,   0,  0, -1
#
  set nei, vec,  1,  2,  3,  4,  5,  6
#
  set mode, 1.0,shift,all
  set move, Cu, 0.02, 0.02, 0.02
  set move, Ag, 0.02, 0.02, 0.02
#
  set targ, 1, lennard, Cu, Ag,  eCA,100., 12,6
  set targ, 1, lennard, Cu, Cu,  eCC,100., 12,6
  set targ, 1, lennard, Ag, Ag,  eAA,100., 12,6
#
  set cyc, ncycle   *n[1]
  set feed,nfeed    *n[1]
#
  set temp,heat
  set finish, stop:converge, diff:0.095, change:0.005, aver:0.001
  set finish, stop:cycles
  show
  run
exit
 

