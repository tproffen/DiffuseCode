plot
  reset
  program   kuplot
  uvw       0, 0, 1
  abs       1, 0, 0
  ord       0, 1, 0
  ext       all
  vect      0,0,0
  thick     1.
  sel       all
  set       0,2,6, 1.0
  set       1,3,3, 1.0
  set       2,3,1, 1.0
exit
#
#
plot
  outf      PLOT/$1.plot
  run
  program jmol
  outf      PLOT/$1_plot.cif
  run
exit
