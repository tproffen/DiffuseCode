#
#
#
refine
#
reset
#
data xy, noise_osci.dat
#
newparam P_ampl, value:0.80,  status:free,  points:5, shift:0.030
newparam P_wvle, value:0.55,  status:free,  points:5, shift:0.003
newparam P_phase,value:0.30,  status:free,  points:5, shift:0.003
newparam P_0    ,value:-0.90, status:free,  points:5, shift:0.003
newparam P_1    ,value:-0.09, status:free,  points:5, shift:0.003
newparam P_2    ,value:-0.003,  status:free,  points:5, shift:0.003
#
set relax,  start:1.0
#
set cycle,   20
set convergence, dchi:0.01, chisq:1.5, conf:0.95
!set convergence, status:off
run k_calc.mac, plot:k_inter.mac
show
exit
#
#
# Test for Success
#
kuplot
load xy, noise_osci.dat
rval 2, 1, dat
r[0] = res[1]
if(abs(r[0])<0.15) then
  echo "COND 1"
  if(abs(P_ampl-1.0)<0.1) then
    echo "COND 2"
    if(abs(P_wvle-0.5)<0.05) then
      echo "COND 3"
      if(abs(P_0+0.95)<0.1) then
        echo "COND 4"
        LTEST_MAC = TRUE
      endif
    endif
  endif
endif
#
exit !  back to suite
