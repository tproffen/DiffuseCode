#
@kpara.mac 0
nfra 2
sfra 1, 0.00, 0.00, 1.00, 1.00
sfra 2, 0.0700, 0.15, 1.00, 1.00
kfra 1, 1, 2, 3
kfra 2, 1, 2, 3
#
afra 1
skal 0, 99,   0,3.0
mark 20, 0.5
font size, 3, 18
font size, 4, 18
#
afra 2
skal 10,  99, 0.080, 0.09999
mark 20, 0.01
tit1
tit2
achx
achy
bfra 2, 1.0,1.0,1.0
#

buff 0.15,0.15,0.15,0.15
plot
save png, arc_para_0.png
wait return
