#
kuplot
@kpara.mac 3
nfra 1
skal 0,100, -1,1
mark 20, 0.5
font size, 3, 18
font size, 4, 18
buff 0.15,0.15,0.15,0.15
plot
save png, arc_para_3.png
wait return
