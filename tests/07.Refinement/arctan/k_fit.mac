reset
load xy, DATA/data.sigma
ccal mul, dy,1,3
skal
mark
plot
fit 1
   p[1]=100
   p[2]=100.1
   p[3]=0.06
   para 1,1,100.0
   para 2,1,100.1
   para 3,1,  0.06
   func fx, 3, p[1]*atan((abs(r[0]-p[2])/p[3]))
   urf 1000
   cycle 50
   wic dat
   para 1,1,100.0
   para 2,1,100.1
   para 3,1,  0.06
   run
   save
   show
exit
skal
mark
plot
rval  1,2,dat
